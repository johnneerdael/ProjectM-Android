<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <nl.neerdael.projectm.core.VisualizerView
        android:id="@+id/visualizer_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Track corner: the playing track as Milkbeat shows it (cover, artist, title) straight over the
         visual; needs notification-listener access. Without a cover the text starts at the margin. -->
    <LinearLayout
        android:id="@+id/track_corner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="@dimen/safe_horizontal"
        android:layout_marginTop="@dimen/safe_vertical"
        android:alpha="0"
        android:animateLayoutChanges="true"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/track_cover"
            android:layout_width="@dimen/track_cover"
            android:layout_height="@dimen/track_cover"
            android:layout_marginEnd="@dimen/track_cover_gap"
            android:background="@drawable/bg_track_cover"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/track_primary"
                style="@style/Overlay.TrackLine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/track_secondary"
                style="@style/Overlay.TrackLine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/track_title"
                android:textSize="22sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Settings panel: compact card inside the overscan-safe area -->
    <ScrollView
        android:id="@+id/overlay_menu"
        android:layout_width="@dimen/panel_width"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginBottom="@dimen/safe_vertical"
        android:layout_marginTop="@dimen/safe_vertical"
        android:layout_marginEnd="@dimen/safe_horizontal"
        android:background="@drawable/bg_overlay_panel"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clickable="true"
            android:paddingStart="12dp"
            android:paddingTop="16dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">

        <!-- Current preset -->
        <TextView
            style="@style/Overlay.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Preset" />

        <TextView
            android:id="@+id/preset_name"
            style="@style/Overlay.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="12dp"
            android:text="Loading…" />

        <TextView
            android:id="@+id/preset_meta"
            style="@style/Overlay.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="2dp"
            android:text="" />

        <!-- What the visualizer hears -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Overlay.Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Audio" />

            <com.example.projectm.visualizer.AudioMeterView
                android:id="@+id/audio_meter"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/audio_status"
                style="@style/Overlay.Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="" />
        </LinearLayout>

        <!-- Transport -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/prev_preset_button"
                style="@style/Overlay.IconButton"
                android:contentDescription="Previous preset"
                android:src="@drawable/ic_skip_previous" />

            <ImageButton
                android:id="@+id/random_preset_button"
                style="@style/Overlay.IconButton"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:contentDescription="Random preset"
                android:src="@drawable/ic_shuffle" />

            <ImageButton
                android:id="@+id/next_preset_button"
                style="@style/Overlay.IconButton"
                android:contentDescription="Next preset"
                android:src="@drawable/ic_skip_next" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/divider" />

        <!-- Settings; the first row only while a downloaded update is ready to install -->
        <com.example.projectm.visualizer.OptionRow
            android:id="@+id/row_install_update"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <com.example.projectm.visualizer.OptionRow
            android:id="@+id/row_audio_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <com.example.projectm.visualizer.OptionRow
            android:id="@+id/row_auto_change"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.example.projectm.visualizer.OptionRow
            android:id="@+id/row_music_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.example.projectm.visualizer.OptionRow
            android:id="@+id/row_preset_duration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.example.projectm.visualizer.OptionRow
            android:id="@+id/row_track_display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.example.projectm.visualizer.OptionRow
            android:id="@+id/row_advanced"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/divider" />

        <!-- Status: fixed width so frequent text updates do not trigger relayouts -->
        <TextView
            android:id="@+id/status_line"
            style="@style/Overlay.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:fontFamily="monospace"
            android:text="" />

        <TextView
            android:id="@+id/version_info"
            style="@style/Overlay.Meta"
            android:singleLine="false"
            android:maxLines="3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="2dp"
            android:text="" />

        <TextView
            android:id="@+id/menu_close"
            style="@style/Overlay.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="8dp"
            android:text="↑↓ select   ‹ › change   BACK close" />
        </LinearLayout>
    </ScrollView>

    <!-- Advanced panel: slides over the main panel; BACK returns -->
    <ScrollView
        android:id="@+id/advanced_menu"
        android:layout_width="@dimen/panel_width"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="@dimen/safe_vertical"
        android:layout_marginBottom="@dimen/safe_vertical"
        android:layout_marginEnd="@dimen/safe_horizontal"
        android:background="@drawable/bg_overlay_panel"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clickable="true"
            android:paddingStart="12dp"
            android:paddingTop="16dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">

            <TextView
                style="@style/Overlay.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Settings  ›  Advanced" />

            <TextView
                style="@style/Overlay.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp"
                android:text="Performance and quality tuning" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/divider" />

            <com.example.projectm.visualizer.OptionRow
                android:id="@+id/row_resolution"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.example.projectm.visualizer.OptionRow
                android:id="@+id/row_frame_rate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.example.projectm.visualizer.OptionRow
                android:id="@+id/row_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.example.projectm.visualizer.OptionRow
                android:id="@+id/row_native_trails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.example.projectm.visualizer.OptionRow
                android:id="@+id/row_transition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.example.projectm.visualizer.OptionRow
                android:id="@+id/row_transition_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.example.projectm.visualizer.OptionRow
                android:id="@+id/row_beat_cuts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.example.projectm.visualizer.OptionRow
                android:id="@+id/row_skip_slow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.example.projectm.visualizer.OptionRow
                android:id="@+id/row_blank_detection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.example.projectm.visualizer.OptionRow
                android:id="@+id/row_auto_update"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.example.projectm.visualizer.OptionRow
                android:id="@+id/row_custom_pack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.example.projectm.visualizer.OptionRow
                android:id="@+id/row_official_collection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <com.example.projectm.visualizer.OptionRow
                android:id="@+id/row_skipped"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Troubleshooting: GPU drivers that crash at preset switches -->
            <com.example.projectm.visualizer.OptionRow
                android:id="@+id/row_background_compile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.example.projectm.visualizer.OptionRow
                android:id="@+id/row_shader_binary_cache"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.example.projectm.visualizer.OptionRow
                android:id="@+id/row_last_exit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/divider" />

            <TextView
            android:id="@+id/advanced_back"
                style="@style/Overlay.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="10dp"
                android:text="↑↓ select   ‹ › change   BACK return" />
        </LinearLayout>
    </ScrollView>

    <!-- Mood panel: slides over the main panel like the advanced one; BACK returns -->
    <ScrollView
        android:id="@+id/mood_menu"
        android:layout_width="@dimen/panel_width"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="@dimen/safe_vertical"
        android:layout_marginBottom="@dimen/safe_vertical"
        android:layout_marginEnd="@dimen/safe_horizontal"
        android:background="@drawable/bg_overlay_panel"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clickable="true"
            android:paddingStart="12dp"
            android:paddingTop="16dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">

            <TextView
                style="@style/Overlay.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Settings  ›  Preset mood" />

            <TextView
                android:id="@+id/mood_header"
                style="@style/Overlay.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp"
                android:accessibilityLiveRegion="polite" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/divider" />

            <com.example.projectm.visualizer.OptionRow
                android:id="@+id/row_mood_collection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/mood_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <com.example.projectm.visualizer.OptionRow
                android:id="@+id/row_mood_clear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/divider" />

            <TextView
                android:id="@+id/mood_back"
                style="@style/Overlay.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="10dp"
                android:text="↑↓ select   ‹ › move   OK toggle   BACK return" />
        </LinearLayout>
    </ScrollView>

    <!-- Track display panel: slides over the main panel like the advanced one; BACK returns -->
    <ScrollView
        android:id="@+id/track_menu"
        android:layout_width="@dimen/panel_width"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginBottom="@dimen/safe_vertical"
        android:layout_marginTop="@dimen/safe_vertical"
        android:layout_marginEnd="@dimen/safe_horizontal"
        android:background="@drawable/bg_overlay_panel"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clickable="true"
            android:paddingStart="12dp"
            android:paddingTop="16dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">

        <TextView
            style="@style/Overlay.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Settings  ›  Track display" />

        <TextView
            style="@style/Overlay.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp"
            android:text="Cover, artist and title of the playing track" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/divider" />

        <com.example.projectm.visualizer.OptionRow
            android:id="@+id/row_track_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.example.projectm.visualizer.OptionRow
            android:id="@+id/row_track_duration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.example.projectm.visualizer.OptionRow
            android:id="@+id/row_track_pill"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/divider" />

        <TextView
            android:id="@+id/track_back"
            style="@style/Overlay.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="10dp"
            android:text="↑↓ select   ‹ › change   BACK return" />
        </LinearLayout>
    </ScrollView>

    <!-- Diagnostics: next to the advanced panel (the main panel is hidden then), so every line fits;
         below the track corner, which stays on screen -->
    <LinearLayout
        android:id="@+id/diagnostics_panel"
        android:layout_width="@dimen/diagnostics_width"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="@dimen/diagnostics_margin_top"
        android:layout_marginEnd="@dimen/diagnostics_margin_end"
        android:background="@drawable/bg_overlay_panel"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <!-- Diagnostics -->
        <TextView
            style="@style/Overlay.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Diagnostics" />

        <TextView
            android:id="@+id/diagnostics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/text_tertiary"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Now-playing pill: the playing track when Track display › Pill style is on (needs
         notification-listener access); also tells about missing audio and a downloaded update -->
    <LinearLayout
        android:id="@+id/now_playing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="@dimen/safe_horizontal"
        android:layout_marginBottom="@dimen/safe_vertical"
        android:alpha="0"
        android:background="@drawable/bg_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/now_playing_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/ic_music_note"
            android:tint="@color/accent"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/now_playing_text"
            style="@style/Overlay.Marquee"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="420dp"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />
    </LinearLayout>

</FrameLayout>
