<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android TV overscan-safe margins -->
    <dimen name="safe_horizontal">48dp</dimen>
    <dimen name="safe_vertical">27dp</dimen>
    <dimen name="panel_width">340dp</dimen>
    <!-- Diagnostics sit left of the advanced panel: safe_horizontal + panel_width + 12dp gap -->
    <dimen name="diagnostics_width">420dp</dimen>
    <dimen name="diagnostics_margin_end">400dp</dimen>
    <dimen name="panel_radius">16dp</dimen>
    <dimen name="row_radius">8dp</dimen>
    <!-- Track corner, as in Milkbeat -->
    <dimen name="track_cover">96dp</dimen>
    <dimen name="track_cover_gap">20dp</dimen>
    <!-- Space between the track corner and the settings panel, which can be open together -->
    <dimen name="track_panel_gap">24dp</dimen>
    <!-- Diagnostics start below the track corner (safe_vertical + track_cover + 24dp) -->
    <dimen name="diagnostics_margin_top">147dp</dimen>
    <!-- Gap between option chips in a facet row -->
    <dimen name="facet_chip_gap">10dp</dimen>
</resources>
