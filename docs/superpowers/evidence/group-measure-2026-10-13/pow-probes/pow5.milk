MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
fDecay=0
fWaveAlpha=0
zoom=1
warp=0
comp_1=`shader_body{
comp_2=`float n = tex2D(sampler_noise_lq, uv).x;
comp_3=`float one = max(n, 1.0);
comp_4=`float y = 0.37 + n*0.0001;
comp_5=`float p = pow(one, y);
comp_6=`float a = frac(p);
comp_7=`ret = float3(a, p < 1 ? 1 : 0, p > 1 ? 1 : 0);
comp_8=`if (uv.x > 0.5) ret = float3(frac(pow(one, y*5.0)), frac(pow(one*0.999, y)), 0.1);
comp_9=`}
