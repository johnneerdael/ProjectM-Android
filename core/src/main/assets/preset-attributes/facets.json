{
  "schema": "projectm-tv-mood-facets",
  "version": 1,
  "combination": "OR within a group, AND across groups; no selection in a group means any",
  "colour_tags": "palette: every hue family with at least 10% of the static display palette; main_colour: only when the predicted top-colour share is at least 0.65 and the palette top share at least 0.55; none for grey presets",
  "measurement": "static source analysis: source-calibrated estimates of the engine-ruler statistics (pinned patched projectM-TV, 480x270, 300 frames at 30 fps, checkpoint audio, frames 60-299); no rendered measurement is shipped. Shipped options come from the static classifiers (precision floors) recorded in the static evidence; the threshold rules below define the scale and the earlier engine-ruler table",
  "activity": "percentile, against the frozen activity reference, of the mean percentile rank of mean_abs_frame_difference, mean_flow_screen_widths_per_s and global_brightness_jumps_per_10s; the reference holds 1001-point quantile tables measured once on the 9,606 bundled presets and is not recomputed per release",
  "activity_reference": {"file": "activity-reference-v1.json", "sha256": "ea7379d751d08da552917eb5a83384cd870a7ee6817cc16e8e9d22b70218ec50"},
  "groups": [
    {"id": "energy", "label": "Energy", "options": [
      {"id": "chill", "label": "Chill", "all": [{"metric": "activity", "op": "<=", "value": 0.35}]},
      {"id": "normal", "label": "Normal", "all": [{"metric": "activity", "op": ">=", "value": 0.25}, {"metric": "activity", "op": "<=", "value": 0.75}]},
      {"id": "intense", "label": "Intense", "all": [{"metric": "activity", "op": ">=", "value": 0.70}]}]},
    {"id": "brightness", "label": "Brightness", "options": [
      {"id": "dark", "label": "Dark", "all": [{"metric": "luminance", "op": "<", "value": 0.12}]},
      {"id": "balanced", "label": "Balanced", "all": [{"metric": "luminance", "op": ">=", "value": 0.12}, {"metric": "luminance", "op": "<=", "value": 0.40}]},
      {"id": "bright", "label": "Bright", "all": [{"metric": "luminance", "op": ">", "value": 0.40}]}]},
    {"id": "colour", "label": "Colour", "options": [
      {"id": "monochrome", "label": "Monochrome", "all": [{"metric": "coloured_share", "op": "<", "value": 0.10}]},
      {"id": "pastel", "label": "Pastel", "all": [{"metric": "luminance", "op": ">", "value": 0.35}, {"metric": "saturation", "op": "<", "value": 0.30}, {"not_option": "monochrome"}]},
      {"id": "vivid", "label": "Vivid", "all": [{"metric": "saturation", "op": ">=", "value": 0.50}]},
      {"id": "warm", "label": "Warm", "all": [{"metric": "warm_cool", "op": ">=", "value": 0.25}]},
      {"id": "cool", "label": "Cool", "all": [{"metric": "warm_cool", "op": "<=", "value": -0.25}]}]},
    {"id": "palette", "label": "Palette", "options": [
      {"id": "red", "label": "Red", "all": [{"palette": "red"}]},
      {"id": "orange", "label": "Orange", "all": [{"palette": "orange"}]},
      {"id": "yellow", "label": "Yellow", "all": [{"palette": "yellow"}]},
      {"id": "green", "label": "Green", "all": [{"palette": "green"}]},
      {"id": "cyan", "label": "Cyan", "all": [{"palette": "cyan"}]},
      {"id": "blue", "label": "Blue", "all": [{"palette": "blue"}]},
      {"id": "purple", "label": "Purple", "all": [{"palette": "purple"}]},
      {"id": "pink", "label": "Pink", "all": [{"palette": "pink"}]}]},
    {"id": "main_colour", "label": "Main colour", "options": [
      {"id": "main_red", "label": "Red", "all": [{"main_colour": "red"}]},
      {"id": "main_orange", "label": "Orange", "all": [{"main_colour": "orange"}]},
      {"id": "main_yellow", "label": "Yellow", "all": [{"main_colour": "yellow"}]},
      {"id": "main_green", "label": "Green", "all": [{"main_colour": "green"}]},
      {"id": "main_cyan", "label": "Cyan", "all": [{"main_colour": "cyan"}]},
      {"id": "main_blue", "label": "Blue", "all": [{"main_colour": "blue"}]},
      {"id": "main_purple", "label": "Purple", "all": [{"main_colour": "purple"}]},
      {"id": "main_pink", "label": "Pink", "all": [{"main_colour": "pink"}]}]},
    {"id": "movement", "label": "Movement", "options": [
      {"id": "still", "label": "Still", "all": [{"metric": "flow", "op": "<", "value": 0.05}]},
      {"id": "drifting", "label": "Drifting", "all": [{"metric": "flow", "op": ">=", "value": 0.05}, {"metric": "flow", "op": "<=", "value": 0.25}]},
      {"id": "fast", "label": "Fast", "all": [{"metric": "flow", "op": ">", "value": 0.25}]}]},
    {"id": "style", "label": "Style", "options": [
      {"id": "kaleidoscope", "label": "Kaleidoscope", "all": [{"style": "kaleidoscope"}]},
      {"id": "tunnel", "label": "Tunnel", "all": [{"style": "tunnel"}]},
      {"id": "liquid", "label": "Liquid", "all": [{"style": "liquid"}]},
      {"id": "geometric", "label": "Geometric", "all": [{"style": "geometric"}]},
      {"id": "particles", "label": "Particles", "all": [{"style": "particles"}]},
      {"id": "fractal", "label": "Fractal", "all": [{"style": "fractal"}]}]},
    {"id": "comfort", "label": "Comfort", "options": [
      {"id": "no_strobe", "label": "No strobe", "all": [{"metric": "jumps", "op": "<", "value": 1.0}]}]}
  ],
  "style_rules": {
    "kaleidoscope": "mechanism angular_mirror_fold, or structure.symmetry >= 0.55",
    "tunnel": "mechanism polar_radial_sampling (polar or log-polar tunnel sampling)",
    "liquid": "mechanism image_driven_advection or gradient_driven_advection, and structure.organic >= 0.6",
    "geometric": "structure.geometric >= 0.6 (polygon/instanced shapes)",
    "particles": "mechanism point_cloud_primitive or procedural_point_motion",
    "fractal": "mechanism nonlinear_feedback_map or complex_quadratic_recurrence, or structure.fractal >= 0.6"
  },
  "provenance": {
    "energy": "static-source-analysis", "brightness": "static-source-analysis", "colour": "static-source-analysis",
    "palette": "static-source-analysis", "main_colour": "static-source-analysis",
    "movement": "static-source-analysis", "comfort": "static-source-analysis", "style": "source-structure-facts"
  }
}
