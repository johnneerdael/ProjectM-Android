diff --git a/src/libprojectM/Renderer/FramebufferDeletion.hpp b/src/libprojectM/Renderer/FramebufferDeletion.hpp
new file mode 100644
index 000000000..e59b8d0cc
--- /dev/null
+++ b/src/libprojectM/Renderer/FramebufferDeletion.hpp
@@ -0,0 +1,103 @@
+#pragma once
+
+#include "OpenGL.h"
+
+#include <algorithm>
+#include <cstring>
+#include <stdexcept>
+
+namespace libprojectM {
+namespace Renderer {
+
+// Imagination drivers can retain the previously bound *complete* framebuffer after
+// deletion. Adapted from Chromium's ensure_previous_framebuffer_not_deleted and
+// Skia commit 02b14267cb023e7ec9fc52618bd12464ceb6afb7 (2026-10-12).
+// The context owns these two tiny objects: deleting the guard could itself trigger
+// the bug. Instances (including repeated prewarm instances) on this thread/context
+// share it; the host must forget it when replacing the context on this thread.
+struct FramebufferDeletionState
+{
+    bool initialized{};
+    GLuint guard{};
+};
+
+inline auto FramebufferDeletionContext() -> FramebufferDeletionState&
+{
+    static thread_local FramebufferDeletionState state;
+    return state;
+}
+
+inline void InitializeFramebufferDeletion()
+{
+    auto& state = FramebufferDeletionContext();
+    if (state.initialized) return;
+    const auto* vendor = reinterpret_cast<const char*>(glGetString(GL_VENDOR));
+    const auto* renderer = reinterpret_cast<const char*>(glGetString(GL_RENDERER));
+    if (!(vendor && std::strstr(vendor, "Imagination")) &&
+        !(renderer && std::strstr(renderer, "PowerVR")))
+    {
+        state.initialized = true;
+        return;
+    }
+
+    GLint read{}, draw{}, renderbuffer{};
+    glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &read);
+    glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &draw);
+    glGetIntegerv(GL_RENDERBUFFER_BINDING, &renderbuffer);
+    GLuint guard{}, storage{};
+    glGenFramebuffers(1, &guard);
+    glGenRenderbuffers(1, &storage);
+    glBindRenderbuffer(GL_RENDERBUFFER, storage);
+    glRenderbufferStorage(GL_RENDERBUFFER, GL_RGBA8, 1, 1);
+    glBindFramebuffer(GL_FRAMEBUFFER, guard);
+    glFramebufferRenderbuffer(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_RENDERBUFFER, storage);
+    const bool complete = guard && storage &&
+                          glCheckFramebufferStatus(GL_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE;
+    // Pre-bind the complete guard separately on both targets before restoring the
+    // caller's split bindings. Do not disturb texture, pixel-unpack or draw state.
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, guard);
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, read);
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER, guard);
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER, draw);
+    glBindRenderbuffer(GL_RENDERBUFFER, renderbuffer);
+    if (!complete) throw std::runtime_error("Could not create PowerVR framebuffer deletion guard");
+    state.guard = guard;
+    state.initialized = true;
+}
+
+inline void ForgetFramebufferDeletion()
+{
+    // No GL calls: the old context may already be gone and its names may alias
+    // unrelated objects in the replacement context. Reinitialize only when the
+    // next ProjectM instance starts, after retiring any stale instance.
+    FramebufferDeletionContext() = {};
+}
+
+inline void DeleteFramebuffers(GLsizei count, const GLuint* ids)
+{
+    const auto guard = FramebufferDeletionContext().guard;
+    if (!guard || count <= 0)
+    {
+        glDeleteFramebuffers(count, ids);
+        return;
+    }
+    GLint read{}, draw{};
+    glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &read);
+    glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &draw);
+    const auto survives = [count, ids](GLint binding) {
+        return std::find(ids, ids + count, static_cast<GLuint>(binding)) == ids + count
+               ? static_cast<GLuint>(binding) : 0u;
+    };
+    // Binding only zero is insufficient: the driver can keep the deleted FBO as
+    // its previous complete binding. Replace both references before any deletion.
+    glBindFramebuffer(GL_FRAMEBUFFER, guard);
+    glBindFramebuffer(GL_FRAMEBUFFER, 0);
+    glDeleteFramebuffers(count, ids);
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, guard);
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, survives(read));
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER, guard);
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER, survives(draw));
+}
+
+} // namespace Renderer
+} // namespace libprojectM
