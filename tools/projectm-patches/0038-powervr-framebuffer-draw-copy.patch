diff --git a/src/libprojectM/Renderer/FramebufferCopy.hpp b/src/libprojectM/Renderer/FramebufferCopy.hpp
new file mode 100644
index 0000000..e244f22
--- /dev/null
+++ b/src/libprojectM/Renderer/FramebufferCopy.hpp
@@ -0,0 +1,165 @@
+#pragma once
+
+#include "Renderer/FramebufferDeletion.hpp"
+#include "Renderer/Sampler.hpp"
+#include "Renderer/Shader.hpp"
+
+#include <array>
+#include <vector>
+
+namespace libprojectM {
+namespace Renderer {
+
+inline bool NeedsFramebufferCopyWorkaround()
+{
+    // Initialized once for this rendering thread/context by ProjectM::Initialize.
+    return FramebufferDeletionContext().guard != 0;
+}
+
+// A colour copy must address colour zero only, even when a motion-vector/integer
+// image is also attached. Restore the actual routing, including disabled slots.
+class ColorCopyDrawBuffers
+{
+public:
+    ColorCopyDrawBuffers(std::vector<GLenum>& saved, GLint maximum)
+        : m_saved(saved)
+    {
+        GLint framebuffer{};
+        glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &framebuffer);
+        m_count = framebuffer ? maximum : 1;
+        if (m_saved.size() < static_cast<size_t>(m_count)) m_saved.resize(m_count);
+        for (GLint i = 0; i < m_count; ++i)
+        {
+            GLint buffer{};
+            glGetIntegerv(GL_DRAW_BUFFER0 + i, &buffer);
+            m_saved[i] = static_cast<GLenum>(buffer);
+        }
+        const GLenum target = framebuffer ? GL_COLOR_ATTACHMENT0 : GL_BACK;
+        glDrawBuffers(1, &target);
+    }
+    ~ColorCopyDrawBuffers() { glDrawBuffers(m_count, m_saved.data()); }
+private:
+    std::vector<GLenum>& m_saved;
+    GLsizei m_count{};
+};
+
+// Used only for the PowerVR workaround (or an explicit host texture copy).
+// Keep one shader/sampler/VAO per owner, not a compile or allocation per frame.
+class FramebufferCopy
+{
+public:
+    FramebufferCopy()
+        : m_sampler(GL_CLAMP_TO_EDGE, GL_LINEAR)
+    {
+#ifdef USE_GLES
+        const std::string version = "#version 300 es\n";
+#else
+        const std::string version = "#version 330\n";
+#endif
+        m_shader.CompileProgram(version + R"(
+precision highp float;
+out vec2 uv;
+void main() {
+    vec2 p = vec2(float((gl_VertexID << 1) & 2), float(gl_VertexID & 2));
+    uv = p;
+    gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0);
+}
+)", version + R"(
+precision highp float;
+precision highp sampler2D;
+in vec2 uv;
+uniform sampler2D source;
+layout(location = 0) out vec4 color;
+void main() { color = textureLod(source, uv, 0.0); }
+)");
+        glGetIntegerv(GL_MAX_DRAW_BUFFERS, &m_maximumDrawBuffers);
+        m_savedDrawBuffers.resize(m_maximumDrawBuffers);
+        glGenVertexArrays(1, &m_vao);
+    }
+    ~FramebufferCopy()
+    {
+        if (m_generation != FramebufferDeletionContext().generation)
+        {
+            m_shader.ForgetProgram();
+            m_sampler.Forget();
+            m_vao = 0;
+        }
+        else if (m_vao) glDeleteVertexArrays(1, &m_vao);
+    }
+
+    void Draw(GLuint texture, int width, int height, GLenum filter)
+    {
+        if (!texture || width <= 0 || height <= 0) return;
+        State state;
+        ColorCopyDrawBuffers drawBuffers(m_savedDrawBuffers, m_maximumDrawBuffers);
+        for (GLenum capability : State::capabilities) glDisable(capability);
+#ifdef USE_GLES
+        glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+#else
+        glColorMaski(0, GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+#endif
+        glViewport(0, 0, width, height);
+        m_shader.Bind();
+        m_shader.SetUniformInt("source", 0);
+        if (m_sampler.FilterMode() != static_cast<GLint>(filter)) m_sampler.FilterMode(filter);
+        m_sampler.Bind(0);
+        glBindTexture(GL_TEXTURE_2D, texture);
+        glBindVertexArray(m_vao);
+        glDrawArrays(GL_TRIANGLES, 0, 3);
+    }
+
+private:
+    struct State
+    {
+        inline static constexpr std::array<GLenum, 9> capabilities = {
+            GL_BLEND, GL_DEPTH_TEST, GL_STENCIL_TEST, GL_CULL_FACE, GL_SCISSOR_TEST,
+            GL_DITHER, GL_RASTERIZER_DISCARD, GL_SAMPLE_ALPHA_TO_COVERAGE, GL_SAMPLE_COVERAGE};
+        GLint program{}, vao{}, active{}, texture{}, sampler{}, viewport[4]{};
+        GLboolean mask[4]{}, enabled[capabilities.size()]{};
+        State()
+        {
+            glGetIntegerv(GL_CURRENT_PROGRAM, &program);
+            glGetIntegerv(GL_VERTEX_ARRAY_BINDING, &vao);
+            glGetIntegerv(GL_VIEWPORT, viewport);
+#ifdef USE_GLES
+            glGetBooleanv(GL_COLOR_WRITEMASK, mask);
+#else
+            glGetBooleani_v(GL_COLOR_WRITEMASK, 0, mask);
+#endif
+            for (size_t i = 0; i < capabilities.size(); ++i) enabled[i] = glIsEnabled(capabilities[i]);
+            glGetIntegerv(GL_ACTIVE_TEXTURE, &active);
+            glActiveTexture(GL_TEXTURE0);
+            glGetIntegerv(GL_TEXTURE_BINDING_2D, &texture);
+            glGetIntegerv(GL_SAMPLER_BINDING, &sampler);
+        }
+        ~State()
+        {
+            glBindVertexArray(vao);
+            glBindTexture(GL_TEXTURE_2D, texture);
+            glBindSampler(0, sampler);
+            glActiveTexture(active);
+            glUseProgram(program);
+            Shader::InvalidateBoundProgram();
+            glViewport(viewport[0], viewport[1], viewport[2], viewport[3]);
+#ifdef USE_GLES
+            glColorMask(mask[0], mask[1], mask[2], mask[3]);
+#else
+            glColorMaski(0, mask[0], mask[1], mask[2], mask[3]);
+#endif
+            for (size_t i = 0; i < capabilities.size(); ++i)
+            {
+                if (enabled[i]) glEnable(capabilities[i]); else glDisable(capabilities[i]);
+            }
+        }
+    };
+
+    uint64_t m_generation{FramebufferDeletionContext().generation};
+    Shader m_shader;
+    Sampler m_sampler;
+    GLuint m_vao{};
+    GLint m_maximumDrawBuffers{};
+    std::vector<GLenum> m_savedDrawBuffers;
+};
+
+} // namespace Renderer
+} // namespace libprojectM
