index e007ec8..ddc4ce3 100644
--- a/src/api/include/projectM-4/render_opengl.h
+++ b/src/api/include/projectM-4/render_opengl.h
@@ -186,6 +186,18 @@ PROJECTM_EXPORT void projectm_opengl_forget_framebuffer_guard();
  */
 PROJECTM_EXPORT void projectm_opengl_delete_framebuffers(int count, const unsigned int* ids);
 
+/** Whether this initialized engine thread/context needs the PowerVR texture-copy workaround. */
+PROJECTM_EXPORT bool projectm_opengl_needs_framebuffer_copy_workaround();
+
+/** Draw a normalized 2D colour texture into the current draw framebuffer, with linear scaling.
+ * Targets colour attachment zero (GL_BACK for the default framebuffer), without glBlitFramebuffer.
+ * Restores touched program, VAO, texture/sampler, viewport, colour mask, enables and draw routing.
+ * The texture must not be attached to the destination. Call on the instance's owning GL context.
+ */
+PROJECTM_EXPORT void projectm_opengl_copy_texture_to_framebuffer(projectm_handle instance, uint32_t texture,
+                                                               int width, int height);
+
+
 /**
  * @brief Memory held by the calling thread's texture pool, in bytes.
  */
