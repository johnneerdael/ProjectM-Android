+// MilkDrop truncates the evaluated flag to int per instance. Match its defined
+// int32 domain without a float-to-int cast or finite comparisons: fast-math can
+// erase floating-point NaN checks. IEEE binary64 magnitudes sort as unsigned bits.
+// Values outside that domain retain the saved parsed style; leave the raw equation
+// variable unchanged. The negative bound allows -2147483648.5 -> INT_MIN.
+auto EvaluatedShapeThickness(PRJM_EVAL_F value, bool savedStyle) -> bool
+{
+    static_assert(std::is_same<PRJM_EVAL_F, double>::value &&
+                  sizeof(PRJM_EVAL_F) == sizeof(std::uint64_t) &&
+                  std::numeric_limits<PRJM_EVAL_F>::is_iec559 &&
+                  std::numeric_limits<PRJM_EVAL_F>::radix == 2 &&
+                  std::numeric_limits<PRJM_EVAL_F>::digits == 53 &&
+                  std::numeric_limits<PRJM_EVAL_F>::max_exponent == 1024,
+                  "Shape thickness requires IEEE binary64 evaluator values");
+    static_assert(std::numeric_limits<int>::digits == 31,
+                  "Shape thickness requires MilkDrop's signed int32 domain");
+    std::uint64_t bits{};
+    std::memcpy(&bits, &value, sizeof(bits));
+    const auto magnitude = bits & UINT64_C(0x7fffffffffffffff);
+    const auto exclusiveBound = (bits & UINT64_C(0x8000000000000000))
+        ? UINT64_C(0x41e0000000200000)  // abs(-2147483649)
+        : UINT64_C(0x41e0000000000000); // +2147483648
+    if (magnitude >= exclusiveBound)
+    {
+        return savedStyle;
+    }
+    return magnitude >= UINT64_C(0x3ff0000000000000); // abs(value) >= 1
+}
