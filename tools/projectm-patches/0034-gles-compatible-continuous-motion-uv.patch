+// Test the exact mixed MRT before TextureAttachment allocates/clears float storage.
+// Deliberately context-local: prewarm and recreated contexts must make their own decision.
+inline bool MotionUVFloatRenderable()
+{
+#ifndef USE_GLES
+    return true; // RG16F is a required desktop GL color format; retain GLSL 330 verbatim.
+#else
+    GLint count = 0;
+    glGetIntegerv(GL_NUM_EXTENSIONS, &count);
+    GLint major = 0, minor = 0;
+    glGetIntegerv(GL_MAJOR_VERSION, &major);
+    glGetIntegerv(GL_MINOR_VERSION, &minor);
+    bool advertised = major > 3 || (major == 3 && minor >= 2); // RG16F color rendering is core in GLES 3.2.
+    for (GLint i = 0; i < count; ++i) {
+        const auto* extension = reinterpret_cast<const char*>(glGetStringi(GL_EXTENSIONS, i));
+        advertised |= extension && (std::strcmp(extension, "GL_EXT_color_buffer_float") == 0 ||
+                                    std::strcmp(extension, "GL_EXT_color_buffer_half_float") == 0);
+    }
+    if (!advertised) return false;
+    GLint read = 0, draw = 0, texture = 0, unpack = 0;
+    glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &read);
+    glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &draw);
+    glGetIntegerv(GL_TEXTURE_BINDING_2D, &texture);
+    glGetIntegerv(GL_PIXEL_UNPACK_BUFFER_BINDING, &unpack);
+    GLuint framebuffer = 0, textures[2] = {};
+    glGenFramebuffers(1, &framebuffer);
+    glGenTextures(2, textures);
+    glBindBuffer(GL_PIXEL_UNPACK_BUFFER, 0);
+    glBindTexture(GL_TEXTURE_2D, textures[0]);
+    glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, 1, 1, 0, GL_RGBA, GL_UNSIGNED_BYTE, nullptr);
+    glBindTexture(GL_TEXTURE_2D, textures[1]);
+    glTexImage2D(GL_TEXTURE_2D, 0, GL_RG16F, 1, 1, 0, GL_RG, GL_FLOAT, nullptr);
+    glBindFramebuffer(GL_FRAMEBUFFER, framebuffer);
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, textures[0], 0);
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT1, GL_TEXTURE_2D, textures[1], 0);
+    const GLenum buffers[] = {GL_COLOR_ATTACHMENT0, GL_COLOR_ATTACHMENT1};
+    glDrawBuffers(2, buffers);
+    const bool complete = glCheckFramebufferStatus(GL_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE;
+    // Never clear or draw to the rejected float target.
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, read);
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER, draw);
+    glBindTexture(GL_TEXTURE_2D, texture);
+    glBindBuffer(GL_PIXEL_UNPACK_BUFFER, unpack);
+    glDeleteFramebuffers(1, &framebuffer);
+    glDeleteTextures(2, textures);
+    return complete;
+#endif
+}
+
+// GLSL ES 3.00 half packing preserves the RG16F representation, including signed/out-of-range
+// values. Encode only the final actual fragment output, after all authored coordinate writes.
+// A discard exits before this wrapper, retaining the previous stored coordinates at that pixel.
+inline std::string PackedMotionUVWarp(std::string source, bool custom)
+{
+    const std::regex main(R"(void\s+main\s*\(\s*\)\s*\{)");
+    if (!std::regex_search(source, main)) throw std::runtime_error("Missing warp GLSL entry point");
+    source = std::regex_replace(source, main, "void projectmtvMotionWarp() {",
+                                std::regex_constants::format_first_only);
+    if (custom) {
+        const std::string output = "out vec4 rast_FragData[2];";
+        const auto at = source.find(output);
+        if (at == std::string::npos) throw std::runtime_error("Missing custom motion UV output");
+        // Retain the generator's exact authored temporaries; only final MRT routing changes.
+        source.replace(at, output.size(), "vec4 rast_FragData[2];\nlayout(location = 0) out vec4 projectmtvWarpColor;\nlayout(location = 1) out highp uvec2 projectmtvPackedUV;");
+    } else {
+        const std::string output = "layout(location = 1) out vec2 texCoords;";
+        const auto at = source.find(output);
+        if (at == std::string::npos) throw std::runtime_error("Missing default motion UV output");
+        source.replace(at, output.size(), "vec2 texCoords;\nlayout(location = 1) out highp uvec2 projectmtvPackedUV;");
+    }
+    source += R"(
+precision highp int;
+highp uvec2 projectmtvEncodeMotionUV(highp vec2 uv)
+{
+    highp uint bits = packHalf2x16(uv);
+    return uvec2(bits & 65535u, bits >> 16u);
+}
+void main()
+{
+    projectmtvMotionWarp();
+)";
+    source += custom ? "    projectmtvWarpColor = rast_FragData[0];\n    projectmtvPackedUV = projectmtvEncodeMotionUV(rast_FragData[1].xy);\n}\n"
+                     : "    projectmtvPackedUV = projectmtvEncodeMotionUV(texCoords);\n}\n";
+    return source;
+}
+
+inline std::string PackedMotionUVConsumer(std::string source)
+{
+    const std::string sampler = "uniform sampler2D warp_coordinates;";
+    const auto samplerAt = source.find(sampler);
+    if (samplerAt == std::string::npos) throw std::runtime_error("Missing motion UV sampler");
+    source.replace(samplerAt, sampler.size(), "uniform highp usampler2D warp_coordinates;");
+    const auto read = source.find("texture(warp_coordinates,");
+    if (read == std::string::npos) throw std::runtime_error("Missing motion UV consumer lookup");
+    const auto end = source.find(").xy", read);
+    if (end == std::string::npos) throw std::runtime_error("Missing motion UV consumer channels");
+    // The lookup argument contains vec2(...); retain that exact coordinate expression.
+    const auto coordinate = read + std::strlen("texture(warp_coordinates,");
+    source.replace(read, end + 4 - read,
+                   "projectmtvSampleMotionUV(" + source.substr(coordinate, end - coordinate) + ")");
+    const auto main = source.find("void main");
+    if (main == std::string::npos) throw std::runtime_error("Missing motion UV consumer entry point");
+    source.insert(main, R"(
+precision highp int;
+highp vec2 projectmtvDecodeMotionUV(ivec2 pixel, ivec2 dimensions)
+{
+    // Integer textures cannot filter. Decode each real half texel before interpolation.
+    highp uvec2 words = texelFetch(warp_coordinates, clamp(pixel, ivec2(0), dimensions - 1), 0).xy;
+    return unpackHalf2x16(words.x | (words.y << 16u));
+}
+highp vec2 projectmtvSampleMotionUV(highp vec2 coordinate)
+{
+    ivec2 dimensions = textureSize(warp_coordinates, 0);
+    highp vec2 pixel = coordinate * vec2(dimensions) - 0.5;
+    ivec2 lower = ivec2(floor(pixel));
+    highp vec2 weight = fract(pixel);
+    return mix(mix(projectmtvDecodeMotionUV(lower, dimensions),
+                   projectmtvDecodeMotionUV(lower + ivec2(1, 0), dimensions), weight.x),
+               mix(projectmtvDecodeMotionUV(lower + ivec2(0, 1), dimensions),
+                   projectmtvDecodeMotionUV(lower + ivec2(1, 1), dimensions), weight.x), weight.y);
+}
+)");
+    return source;
+}
+
+} // namespace MilkdropPreset
+} // namespace libprojectM
